# =============================================================================
#  MIKROTIK CRS326-24G-2S+ (RouterOS 7.22) - отключение обнаружения соседей
#  и контроль MAC-адресов через bridge filter
#  IP управления: 10.19.103.27, тестируемый порт: ether1 (сегмент 10.10.10.0/24)
#  Соответствует разделу 6.3 статьи.
# =============================================================================
#
#  ВАЖНО ПРО ПЛАТФОРМУ
#  --------------------
#  У RouterOS 7 НЕТ отдельной функции "Port Security", как на Cisco/Eltex.
#  Её роль на bridge-портах выполняет более универсальный, но и более
#  трудоёмкий в настройке механизм /interface bridge filter. Порядок правил
#  ВАЖЕН: правило accept для легитимного MAC должно идти РАНЬШЕ финального
#  drop, иначе будет заблокирован и легитимный трафик тоже.
#
#  ПЕРЕД НАЧАЛОМ
#  --------------
#  1. Подключитесь через WinBox, WebFig, SSH или консоль:
#         ssh admin@10.19.103.27
#  2. Уточните список интерфейсов и их текущее состояние:
#         [admin@MikroTik] > /interface print
#     В статье использован порт ether1 - замените на нужный, если отличается.
#  3. Узнайте текущий (легитимный) MAC-адрес хоста, подключённого к порту,
#     например через ARP-таблицу:
#         [admin@MikroTik] > /ip arp print
#     В статье легитимный MAC атакующей/тестовой машины - 00:90:F5:F5:FB:5A.
#     Замените на MAC вашего реального устройства.
#
# =============================================================================
#  ШАГ 1. Проверка ИСХОДНОГО состояния обнаружения соседей
# =============================================================================

/ip/neighbor/discovery-settings/print
#   Ожидаемый вывод "из коробки":
#     discover-interface-list: static
#     discover-interval: 30s
#     protocol: cdp,lldp,mndp
#     mode: tx-and-rx
#   Это значит, что MikroTik ОДНОВРЕМЕННО рассылает и принимает ВСЕ ТРИ
#   протокола автообнаружения (CDP, LLDP, MNDP) на портах из списка "static"
#   без каких-либо действий администратора - самая "открытая" из трёх
#   исследованных платформ.

/ip/neighbor/print
#   Показывает, кого коммутатор УЖЕ обнаружил на своих портах - удобно для
#   первичной оценки, что вообще "видно" в сети без всякой атаки.

# =============================================================================
#  ШАГ 2. Защита - полностью отключить обнаружение соседей
# =============================================================================
#  discover-interface-list=none отключает как ОТПРАВКУ, так и ПРИЁМ кадров
#  автообнаружения (CDP/LLDP/MNDP) на всех интерфейсах. Если нужно оставить
#  discovery включённым на доверенных портах (например, аплинк к другому
#  MikroTik) и выключить только на порту доступа, вместо "none" создайте
#  отдельный interface list без опасного порта - см. блок "ТОЧЕЧНОЕ
#  ОТКЛЮЧЕНИЕ" ниже.

/ip neighbor discovery-settings set discover-interface-list=none

#   Проверка результата:
/ip/neighbor/discovery-settings/print
#   Ожидаемо: discover-interface-list: none
#   (значения protocol и mode при этом не меняются - это нормально,
#   именно discover-interface-list=none и отключает функцию целиком).

# =============================================================================
#  ШАГ 2а (ОПЦИОНАЛЬНО). ТОЧЕЧНОЕ ОТКЛЮЧЕНИЕ только на порту доступа,
#           если discovery нужно оставить на других портах
# =============================================================================

/interface list add name=trusted-discovery
/interface list member add interface=ether2 list=trusted-discovery
# (добавьте сюда все ДОВЕРЕННЫЕ интерфейсы, кроме ether1)
/ip neighbor discovery-settings set discover-interface-list=trusted-discovery
# Теперь discovery работает только на портах из списка trusted-discovery,
# а ether1 (порт доступа) в этот список не входит и защищён.

# =============================================================================
#  ШАГ 3. Контроль MAC-адресов на порту через bridge filter
# =============================================================================
#  Правило 1 (должно идти ПЕРВЫМ): разрешить трафик только от легитимного
#  MAC-адреса. chain=input означает "трафик, адресованный самому
#  устройству" (соответствует логике проверки на входящем порту доступа).

/interface bridge filter add chain=input in-interface=ether1 \
    src-mac-address=00:90:F5:F5:FB:5A/FF:FF:FF:FF:FF:FF action=accept

#  Правило 2 (должно идти ВТОРЫМ, после accept): весь остальной трафик
#  на этом же интерфейсе - отбросить. Если поменять правила местами,
#  drop сработает раньше accept, и легитимный хост тоже потеряет связь.

/interface bridge filter add chain=input in-interface=ether1 action=drop

#   Проверка списка правил и их порядка:
/interface bridge filter print
#   Убедитесь, что accept-правило имеет МЕНЬШИЙ номер (выше в списке),
#   чем drop-правило.

# =============================================================================
#  ШАГ 4. Верификация
# =============================================================================

/ip arp print
#   Убедитесь, что легитимный MAC присутствует в таблице ARP на ether1.

/interface bridge filter print stats
#   Счётчики срабатывания правил: после теста с подменой MAC (см. ниже)
#   счётчик у правила drop должен увеличиться, у accept - остаться прежним
#   (или расти только на легитимном трафике).

# =============================================================================
#  ШАГ 5. Тест - подмена MAC-адреса на стороне атакующей машины (PC1)
# =============================================================================
#  Выполняется НЕ на MikroTik, а на самой атакующей машине (Linux):
#
#      ip link set dev <iface> down
#      ip link set dev <iface> address 00:11:22:33:44:55
#      ip link set dev <iface> up
#      ping 10.10.10.1
#
#  Ожидаемый результат при подмене MAC: ICMP Destination Host Unreachable
#  на всех пакетах (100% потерь). При возврате исходного MAC-адреса
#  связность должна восстановиться без дополнительных действий на MikroTik.

# =============================================================================
#  ОТКАТ (вернуть исходное состояние "из коробки")
# =============================================================================

/interface bridge filter remove [find in-interface=ether1]
/ip neighbor discovery-settings set discover-interface-list=static

# =============================================================================
#  ЧАСТЫЕ ОШИБКИ
# =============================================================================
#  - Правила bridge filter добавлены в неверном порядке (drop раньше
#    accept) -> легитимный хост тоже теряет связь. Решение: удалить оба
#    правила и добавить заново в правильном порядке, либо использовать
#    /interface bridge filter move для изменения порядка.
#  - Указан не тот in-interface - убедитесь, что имя интерфейса совпадает
#    с выводом /interface print (например, ether1, а не Ether1 или eth1).
#  - discover-interface-list=none отключает discovery ГЛОБАЛЬНО на всех
#    портах - если это нежелательно, используйте вариант из шага 2а.
